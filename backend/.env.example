# Stream backend: "memory" (zero-dependency local dev) or "redis"
VEGA_STREAM_BACKEND=memory
VEGA_REDIS_URL=redis://127.0.0.1:6379/0

# Ephemeral stream lifecycle
VEGA_RETENTION_SECONDS=600
VEGA_CLEANUP_INTERVAL_SECONDS=5
VEGA_WINDOW_SECONDS=120
VEGA_EARLY_ANALYSIS=true
VEGA_STAGE_DELAY_SECONDS=5.0

# Gemini reasoning (used by Track B/C agents)
# swarm_mode: "auto" (uses Gemini when GEMINI_API_KEY is set, else heuristic fallback), "gemini", or "heuristic"
VEGA_SWARM_MODE=auto
VEGA_SWARM_MAX_CONCURRENCY=6
VEGA_GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Oracle council (backend/oracle)
# ORACLE_BRIDGE=1 runs the council on each Sentinel SEV1; ORACLE_BRIDGE_MOCK=1 uses canned opinions
ORACLE_BRIDGE=0
ORACLE_BRIDGE_MOCK=0
ORACLE_MODEL=gemini-3.5-flash-lite
ORACLE_MAX_CONCURRENCY=3
ORACLE_COUNCIL_MODE=combined

# TypeSafe AI System One (Jev) + Warden live containment
TYPESAFE_API_KEY=
VEGA_JEV_MODEL=jev-latest
VEGA_JEV_CONFIDENCE_THRESHOLD=0.75
VEGA_JEV_PROBABILITY_THRESHOLD=0.80
VEGA_JEV_SAFE_AUTOMATE_THRESHOLD=0.70
VEGA_WARDEN_ENABLED=true
VEGA_WARDEN_DRY_RUN=false
VEGA_WARDEN_TELEMETRY_HOST=10.97.0.1
AUTH0_DOMAIN=dev-aouetthi51by1teb.us.auth0.com
AUTH0_WARDEN_CLIENT_ID=
AUTH0_WARDEN_CLIENT_SECRET=
